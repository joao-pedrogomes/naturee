{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "exclude": ["worker/testing", "worker/**/*.test.ts"],
  "include": ["worker", "src/content/overrides.ts", "src/lib/serializeContent.ts", "src/routes.ts", "scripts/htmlShell.ts"]
}
