{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natureefoodhub",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "natureefoodhub.com.br", "custom_domain": true },
    { "pattern": "www.natureefoodhub.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
