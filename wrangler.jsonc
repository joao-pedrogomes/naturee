{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natureefoodhub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "natureefoodhub.com.br", "custom_domain": true },
    { "pattern": "www.natureefoodhub.com.br", "custom_domain": true }
  ],
  "alias": { "@ssr": "./dist-ssr/entryServer.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/", "/sobre", "/sobre/", "/marcas-e-produtos", "/marcas-e-produtos/", "/logistica", "/logistica/",
      "/contato", "/contato/", "/sitemap.xml", "/admin", "/admin/*", "/api/*", "/media/*", "/catalogo/*"
    ]
  },
  "version_metadata": { "binding": "CF_VERSION" },
  "d1_databases": [
    { "binding": "DB", "database_name": "naturee", "database_id": "d6f467ec-95b8-40a4-9936-4bef9d4f6ae6", "migrations_dir": "migrations" }
  ]
}
